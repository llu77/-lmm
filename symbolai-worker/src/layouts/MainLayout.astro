---
import '@/styles/globals.css';
import NotificationBell from '@/components/NotificationBell.astro';

// No <ClientRouter />: with client-side navigation, page <script> modules run
// only on the first visit, so returning to a page left it without data or
// event handlers. Full page loads keep every page's script working.

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'نظام إدارة مالية - SymbolAI',
  description = 'نظام متكامل لإدارة المالية والموارد البشرية'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <div class="min-h-screen bg-background">
    <!-- Header/Navigation -->
    <header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 print:hidden">
      <div class="container flex h-14 items-center gap-4">
        <a href="/dashboard" class="flex shrink-0 items-center">
          <span class="font-bold">SymbolAI المالية</span>
        </a>
        <nav id="main-nav" class="flex min-w-0 flex-1 items-center gap-5 overflow-x-auto whitespace-nowrap text-sm font-medium">
          {[
            { href: '/dashboard', label: 'لوحة التحكم' },
            { href: '/revenues', label: 'الإيرادات' },
            { href: '/expenses', label: 'المصروفات' },
            { href: '/employees', label: 'الموظفين' },
            { href: '/bonus', label: 'البونص' },
            { href: '/payroll', label: 'الرواتب' },
            { href: '/advances-deductions', label: 'المستحقات والاستقطاعات' },
            { href: '/vouchers', label: 'السندات' },
            { href: '/manage-requests', label: 'الطلبات' },
            { href: '/my-requests', label: 'طلباتي' },
            { href: '/product-orders', label: 'الطلبيات' },
            { href: '/settings', label: 'الإعدادات' },
            { href: '/ai-assistant', label: 'المساعد الذكي' },
          ].map(item => {
            const active = Astro.url.pathname === item.href || Astro.url.pathname.startsWith(`${item.href}/`);
            return (
              <a
                href={item.href}
                class:list={['transition-colors hover:text-foreground/80', active ? 'text-foreground font-semibold' : 'text-foreground/60']}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
        <div class="flex shrink-0 items-center gap-2">
          <NotificationBell />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto py-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t py-6 md:py-0">
      <div class="container flex flex-col items-center justify-between gap-4 md:h-24 md:flex-row">
        <p class="text-center text-sm leading-loose text-muted-foreground md:text-right">
          بُني بواسطة <span class="font-medium">SymbolAI</span>. نظام إدارة مالية متكامل على Cloudflare.
        </p>
      </div>
    </footer>
  </div>
</body>
</html>
