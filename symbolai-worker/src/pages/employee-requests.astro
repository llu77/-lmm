---
import MainLayout from '@/layouts/MainLayout.astro';

// Check authentication
const cookieHeader = Astro.request.headers.get('Cookie');
if (!cookieHeader?.includes('session=')) {
  return Astro.redirect('/auth/login');
}
---

<MainLayout title="طلبات الموظفين - SymbolAI">
  <div class="mx-auto max-w-xl rounded-lg border bg-card p-6 text-center space-y-4">
    <h1 class="text-2xl font-bold">طلبات الموظفين</h1>
    <p id="redirect-status" class="text-muted-foreground" aria-live="polite">جاري تحويلك إلى الصفحة المناسبة...</p>
    <div id="redirect-links" class="hidden flex flex-wrap justify-center gap-3">
      <a href="/manage-requests" class="px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700">إدارة طلبات الموظفين</a>
      <a href="/my-requests" class="px-4 py-2 rounded-md border hover:bg-gray-50">طلباتي</a>
    </div>
  </div>

  <script>
    import { loadFinanceContext } from '@/lib/finance/client';

    // This page was merged into /manage-requests (supervisors and approvers) and
    // /my-requests (everyone else).
    loadFinanceContext()
      .then(ctx => {
        const manages = ctx.permissions.canManageRequests || ctx.permissions.canApproveRequests;
        window.location.replace(manages ? '/manage-requests' : '/my-requests');
      })
      .catch(error => {
        const status = document.getElementById('redirect-status');
        if (status) status.textContent = `تعذر تحديد صلاحياتك (${(error as Error).message}) — اختر الصفحة:`;
        document.getElementById('redirect-links')?.classList.remove('hidden');
      });
  </script>
</MainLayout>
