        <span id="sig-view-status" class="text-sm text-gray-500">جاري التحميل…</span>
      </div>
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
        <dt class="text-gray-500">الاسم</dt><dd id="sig-view-name">—</dd>
        <dt class="text-gray-500">الصفة</dt><dd id="sig-view-role">—</dd>
