---
import MainLayout from '@/layouts/MainLayout.astro';

// Check authentication - redirect to login if not authenticated
const cookieHeader = Astro.request.headers.get('Cookie');
if (!cookieHeader?.includes('session=')) {
  return Astro.redirect('/auth/login');
}

const inputClass = 'w-full rounded-md border px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-600';
const signerTitles = ['المدير العام', 'المدير المالي', 'المحاسب', 'مشرف الفرع', 'أمين الصندوق', 'مدير الموارد البشرية'];
---

<MainLayout title="الإعدادات - SymbolAI">
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold">الإعدادات</h1>
      <p class="mt-2 text-gray-600">بيانات المنشأة والختم والتواقيع التي تظهر على السندات ومسيرات الرواتب المطبوعة</p>
    </div>

    <div id="page-loading" class="rounded-lg border bg-card p-6 text-center text-gray-500" role="status">جاري تحميل الإعدادات…</div>
    <div id="page-error" class="hidden rounded-lg border border-red-200 bg-red-50 p-6 text-center" role="alert">
      <p id="page-error-text" class="text-red-700"></p>
      <button id="page-retry" type="button" class="mt-3 rounded-md border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-100">إعادة المحاولة</button>
    </div>

    <!-- ================================================================== -->
    <!-- 1. Organization profile                                             -->
    <!-- ================================================================== -->
    <section id="org-section" class="hidden rounded-lg border bg-card p-6" aria-labelledby="org-title">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="org-title" class="text-xl font-semibold">بيانات المنشأة</h2>
          <p class="mt-1 text-sm text-gray-600">تظهر في ترويسة سندات القبض والصرف ومسيرات الرواتب.</p>
        </div>
        <div class="flex items-center gap-2">
          <span id="org-readonly-badge" class="hidden rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">للاطلاع فقط — التعديل للمدير</span>
          <span id="org-dirty-badge" class="hidden rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800">تغييرات غير محفوظة</span>
        </div>
      </div>

      <div class="mt-4 flex gap-3 rounded-lg border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900">
        <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <div class="space-y-1">
          <p class="font-semibold">متى يظهر الختم والتوقيع؟</p>
          <p>يظهر <strong>ختم المنشأة</strong> و<strong>توقيع المدير</strong> على سندات القبض والصرف ومسيرات الرواتب المطبوعة <strong>فقط بعد اعتماد المدير</strong> للمستند. قبل الاعتماد تبقى خانة الاعتماد فارغة ولا يُطبع الختم.</p>
          <p class="text-blue-800">إذا لم يُرفع ختم، يُطبع ختم نصي تلقائي يحمل اسم المنشأة بعد الاعتماد.</p>
        </div>
      </div>

      <p id="org-status" class="hidden mt-4 text-sm"></p>

      <form id="org-form" class="mt-6 space-y-6" novalidate>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label for="org-name-ar" class="mb-1.5 block text-sm font-medium">اسم المنشأة (عربي)</label>
            <input id="org-name-ar" name="companyNameAr" type="text" maxlength="150" class={inputClass} placeholder="مثال: مؤسسة الرمز التجارية" />
          </div>
          <div>
            <label for="org-name-en" class="mb-1.5 block text-sm font-medium">اسم المنشأة (إنجليزي)</label>
            <input id="org-name-en" name="companyNameEn" type="text" maxlength="150" dir="ltr" class={`${inputClass} text-left`} placeholder="Symbol Trading Est." />
          </div>
          <div>
            <label for="org-cr" class="mb-1.5 block text-sm font-medium">رقم السجل التجاري</label>
            <input id="org-cr" name="crNumber" type="text" inputmode="numeric" maxlength="20" dir="ltr" class={`${inputClass} text-left`} placeholder="1010xxxxxx" />
          </div>
          <div>
            <label for="org-vat" class="mb-1.5 block text-sm font-medium">الرقم الضريبي (VAT)</label>
            <input id="org-vat" name="vatNumber" type="text" inputmode="numeric" maxlength="15" dir="ltr" class={`${inputClass} text-left`} placeholder="3xxxxxxxxxxxxx3" aria-describedby="org-vat-hint" />
            <p id="org-vat-hint" class="mt-1 text-xs text-gray-500">15 رقماً، يبدأ وينتهي بالرقم 3 للمنشآت السعودية.</p>
          </div>
          <div>
            <label for="org-phone" class="mb-1.5 block text-sm font-medium">الهاتف</label>
            <input id="org-phone" name="phone" type="tel" maxlength="100" dir="ltr" class={`${inputClass} text-left`} placeholder="+966 11 000 0000" />
          </div>
          <div>
            <label for="org-email" class="mb-1.5 block text-sm font-medium">البريد الإلكتروني</label>
            <input id="org-email" name="email" type="email" maxlength="300" dir="ltr" class={`${inputClass} text-left`} placeholder="info@example.com" />
          </div>
          <div class="md:col-span-2">
            <label for="org-address" class="mb-1.5 block text-sm font-medium">العنوان</label>
            <input id="org-address" name="address" type="text" maxlength="300" class={inputClass} placeholder="المملكة العربية السعودية - الرياض" />
          </div>
          <div>
            <label for="org-currency" class="mb-1.5 block text-sm font-medium">العملة</label>
            <select id="org-currency" name="currency" class={inputClass}>
              <option value="SAR">ريال سعودي (ر.س) — SAR</option>
              <option value="AED">درهم إماراتي (د.إ) — AED</option>
              <option value="KWD">دينار كويتي (د.ك) — KWD</option>
              <option value="EGP">جنيه مصري (ج.م) — EGP</option>
              <option value="USD">دولار أمريكي ($) — USD</option>
            </select>
          </div>
          <div>
            <label for="org-vat-rate" class="mb-1.5 block text-sm font-medium">نسبة ضريبة القيمة المضافة (%)</label>
            <input id="org-vat-rate" name="vatRate" type="number" min="0" max="100" step="0.01" dir="ltr" class={`${inputClass} text-left`} />
          </div>
          <div class="md:col-span-2">
            <div class="mb-1.5 flex items-center justify-between">
              <label for="org-footer" class="block text-sm font-medium">ملاحظة تذييل المستندات</label>
              <span id="org-footer-count" class="text-xs text-gray-500" aria-live="polite">0/300</span>
            </div>
            <textarea id="org-footer" name="documentFooter" rows="2" maxlength="300" class={inputClass} placeholder="مثال: هذا السند صادر إلكترونياً ولا يعتد به إلا بعد الاعتماد والختم"></textarea>
          </div>
        </div>

        <!-- Logo + stamp -->
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-semibold">شعار المنشأة</h3>
              <span id="logo-state" class="text-xs text-amber-700"></span>
            </div>
            <div class="checkerboard mt-3 flex h-40 items-center justify-center overflow-hidden rounded-md border">
              <img id="logo-preview" alt="معاينة الشعار" class="hidden max-h-36 max-w-[90%] object-contain" />
              <span id="logo-empty" class="text-sm text-gray-500">لا يوجد شعار</span>
            </div>
            <div class="org-edit mt-3 flex flex-wrap gap-2">
              <button id="logo-pick" type="button" class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50">اختيار صورة</button>
              <button id="logo-remove" type="button" class="rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50">إزالة الشعار</button>
              <input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
            </div>
            <p class="org-edit mt-2 text-xs text-gray-500">PNG أو JPG أو WebP. تُصغَّر الصورة تلقائياً إلى 500 بكسل كحد أقصى.</p>
          </div>

          <div class="rounded-lg border p-4">
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-semibold">ختم المنشأة</h3>
              <span id="stamp-state" class="text-xs text-amber-700"></span>
            </div>
            <div class="checkerboard mt-3 flex h-40 items-center justify-center overflow-hidden rounded-md border">
              <img id="stamp-preview" alt="معاينة ختم المنشأة" class="hidden max-h-36 max-w-[90%] object-contain" />
              <span id="stamp-empty" class="text-sm text-gray-500">لم يُرفع ختم — يُستخدم ختم نصي تلقائي</span>
            </div>
            <div class="org-edit mt-3 flex flex-wrap items-center gap-2">
              <button id="stamp-pick" type="button" class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50">اختيار صورة الختم</button>
              <button id="stamp-remove" type="button" class="rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50">إزالة الختم</button>
              <input id="stamp-file" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
            </div>
            <label class="org-edit mt-3 flex items-center gap-2 text-sm">
              <input id="stamp-remove-white" type="checkbox" class="h-4 w-4" checked />
              <span>إزالة الخلفية البيضاء (يُنصح بها للختم المصوَّر أو الممسوح ضوئياً)</span>
            </label>
            <p class="org-edit mt-2 text-xs text-gray-500">صوّر الختم على ورقة بيضاء بإضاءة جيدة. يظهر الختم مائلاً قليلاً فوق خانة اعتماد المدير.</p>
          </div>
        </div>

        <div id="org-actions" class="flex flex-wrap gap-3 border-t pt-4">
          <button id="org-save" type="submit" class="rounded-md bg-primary px-6 py-2 font-medium text-white hover:bg-primary/90 disabled:opacity-60">حفظ بيانات المنشأة</button>
          <button id="org-reset" type="button" class="rounded-md border px-4 py-2 font-medium hover:bg-gray-50 disabled:opacity-60">تراجع عن التغييرات</button>
        </div>
      </form>
    </section>

    <!-- ================================================================== -->
    <!-- 2. My signature                                                    -->
    <!-- ================================================================== -->
    <section id="my-signature-section" class="hidden rounded-lg border bg-card p-6" aria-labelledby="my-sig-title">
      <h2 id="my-sig-title" class="text-xl font-semibold">توقيعي</h2>
      <p class="mt-1 text-sm text-gray-600">يُطبع توقيعك على السندات ومسيرات الرواتب التي تُعدّها أو تعتمدها. ارسمه مباشرة أو ارفع صورة له.</p>
      <p id="my-sig-status" class="hidden mt-4 text-sm"></p>
      <div id="my-sig-body" class="mt-4 grid gap-4 md:grid-cols-[minmax(0,22rem)_1fr]">
        <div class="checkerboard flex h-40 items-center justify-center overflow-hidden rounded-md border">
          <img id="my-sig-img" alt="توقيعي المحفوظ" class="hidden max-h-36 max-w-[90%] object-contain" />
          <span id="my-sig-empty" class="px-4 text-center text-sm text-gray-500">لم تُضف توقيعاً بعد</span>
        </div>
        <div class="space-y-3">
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-gray-500">الاسم على المستندات</dt><dd id="my-sig-name" class="font-medium">—</dd>
            <dt class="text-gray-500">الصفة</dt><dd id="my-sig-title-text" class="font-medium">—</dd>
            <dt class="text-gray-500">آخر تحديث</dt><dd id="my-sig-updated" class="font-medium">—</dd>
          </dl>
          <div class="flex flex-wrap gap-2">
            <button id="my-sig-edit" type="button" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-white hover:bg-primary/90">إضافة توقيع</button>
            <button id="my-sig-delete" type="button" class="hidden rounded-md border border-red-200 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 disabled:opacity-60">حذف التوقيع</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================== -->
    <!-- 3. Users' signatures (manager)                                     -->
    <!-- ================================================================== -->
    <section id="users-sig-section" class="hidden rounded-lg border bg-card p-6" aria-labelledby="users-sig-title">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="users-sig-title" class="text-xl font-semibold">تواقيع المستخدمين</h2>
          <p class="mt-1 text-sm text-gray-600">سجّل أو استبدل تواقيع المستخدمين الحاليين (المشرفين والمحاسبين وغيرهم) لتظهر على المستندات التي يعدّونها أو يستلمونها.</p>
        </div>
        <button id="users-sig-refresh" type="button" class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50 disabled:opacity-60">تحديث</button>
      </div>

      <div class="mt-4 flex flex-wrap items-end gap-3">
        <div class="min-w-[12rem] flex-1">
          <label for="users-sig-search" class="mb-1.5 block text-sm font-medium">بحث</label>
          <input id="users-sig-search" type="search" class={inputClass} placeholder="الاسم أو اسم المستخدم أو الفرع" />
        </div>
        <div>
          <label for="users-sig-filter" class="mb-1.5 block text-sm font-medium">الحالة</label>
          <select id="users-sig-filter" class={inputClass}>
            <option value="all">جميع المستخدمين</option>
            <option value="missing">بدون توقيع</option>
            <option value="present">لديهم توقيع</option>
          </select>
        </div>
        <p id="users-sig-summary" class="pb-2 text-sm text-gray-600" aria-live="polite"></p>
      </div>

      <div class="mt-4 overflow-x-auto rounded-lg border">
        <table class="w-full text-sm">
          <thead class="border-b bg-gray-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-right font-medium">المستخدم</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">الدور</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">الفرع</th>
              <th scope="col" class="px-4 py-3 text-center font-medium">التوقيع</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">الصفة</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">آخر تحديث</th>
              <th scope="col" class="px-4 py-3 text-right font-medium">الإجراءات</th>
            </tr>
          </thead>
          <tbody id="users-sig-body">
            <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">جاري التحميل…</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- ==================================================================== -->
  <!-- Signature editor dialog (draw / upload)                               -->
  <!-- ==================================================================== -->
  <dialog id="sig-dialog" class="w-[min(44rem,calc(100vw-1.5rem))] max-h-[calc(100vh-1.5rem)] overflow-y-auto rounded-lg bg-white p-0 text-right shadow-2xl backdrop:bg-black/50" aria-labelledby="sig-dialog-title">
    <div class="space-y-4 p-5 sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="sig-dialog-title" class="text-xl font-bold">توقيعي</h2>
          <p id="sig-dialog-subtitle" class="mt-1 text-sm text-gray-600"></p>
        </div>
        <button id="sig-dialog-close" type="button" class="rounded-md p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-900" aria-label="إغلاق">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <div id="sig-current" class="hidden items-center gap-3 rounded-md border bg-gray-50 p-3">
        <div class="checkerboard flex h-16 w-40 shrink-0 items-center justify-center overflow-hidden rounded border">
          <img id="sig-current-img" alt="التوقيع الحالي" class="max-h-14 max-w-[95%] object-contain" />
        </div>
        <p class="text-xs text-gray-600">التوقيع الحالي. ارسم أو ارفع توقيعاً جديداً لاستبداله، أو عدّل الصفة فقط ثم احفظ.</p>
      </div>

      <div role="tablist" aria-label="طريقة إضافة التوقيع" class="inline-flex rounded-lg border bg-gray-50 p-1">
        <button id="sig-tab-draw" type="button" role="tab" aria-selected="true" aria-controls="sig-panel-draw" class="sig-tab rounded-md px-4 py-1.5 text-sm font-medium">رسم التوقيع</button>
        <button id="sig-tab-upload" type="button" role="tab" aria-selected="false" aria-controls="sig-panel-upload" tabindex="-1" class="sig-tab rounded-md px-4 py-1.5 text-sm font-medium">رفع صورة</button>
      </div>

      <div id="sig-panel-draw" role="tabpanel" aria-labelledby="sig-tab-draw" class="space-y-2">
        <div class="relative rounded-lg border-2 border-dashed border-gray-300 bg-white">
          <canvas id="sig-canvas" class="block h-52 w-full cursor-crosshair touch-none select-none rounded-lg" aria-label="مساحة رسم التوقيع — ارسم بالفأرة أو الإصبع أو القلم"></canvas>
          <div class="pointer-events-none absolute inset-x-6 bottom-12 border-b border-gray-300" aria-hidden="true"></div>
          <span id="sig-pad-hint" class="pointer-events-none absolute inset-0 flex items-center justify-center text-sm text-gray-400">ارسم توقيعك هنا</span>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2 text-sm">
            <span class="text-gray-600">لون الحبر:</span>
            <button type="button" data-ink="#1e3a8a" class="ink-btn h-7 w-7 rounded-full border-2 border-white bg-[#1e3a8a] ring-2 ring-gray-300" aria-label="أزرق" aria-pressed="true"></button>
            <button type="button" data-ink="#111827" class="ink-btn h-7 w-7 rounded-full border-2 border-white bg-[#111827] ring-2 ring-gray-300" aria-label="أسود" aria-pressed="false"></button>
          </div>
          <div class="flex gap-2">
            <button id="sig-undo" type="button" class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50 disabled:opacity-50" disabled>تراجع</button>
            <button id="sig-clear" type="button" class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50 disabled:opacity-50" disabled>مسح</button>
          </div>
        </div>
      </div>

      <div id="sig-panel-upload" role="tabpanel" aria-labelledby="sig-tab-upload" class="hidden space-y-3">
        <div class="checkerboard flex h-52 items-center justify-center overflow-hidden rounded-lg border">
          <img id="sig-upload-preview" alt="معاينة التوقيع المرفوع" class="hidden max-h-48 max-w-[90%] object-contain" />
          <span id="sig-upload-empty" class="px-4 text-center text-sm text-gray-500">اختر صورة واضحة للتوقيع على ورقة بيضاء</span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button id="sig-upload-pick" type="button" class="rounded-md border px-3 py-1.5 text-sm font-medium hover:bg-gray-50">اختيار صورة</button>
          <input id="sig-upload-file" type="file" accept="image/png,image/jpeg,image/webp" class="hidden" />
          <label class="flex items-center gap-2 text-sm">
            <input id="sig-upload-remove-white" type="checkbox" class="h-4 w-4" checked />
            <span>إزالة الخلفية البيضاء</span>
          </label>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="sig-title-input" class="mb-1.5 block text-sm font-medium">الصفة</label>
          <input id="sig-title-input" type="text" maxlength="100" list="signer-titles" class={inputClass} placeholder="مثال: المحاسب" />
          <datalist id="signer-titles">
            {signerTitles.map(t => <option value={t} />)}
          </datalist>
        </div>
        <div>
          <label for="sig-name-input" class="mb-1.5 block text-sm font-medium">الاسم على المستندات <span class="font-normal text-gray-500">(اختياري)</span></label>
          <input id="sig-name-input" type="text" maxlength="100" class={inputClass} />
        </div>
      </div>

      <div class="flex flex-wrap gap-3 border-t pt-4">
        <button id="sig-save" type="button" class="rounded-md bg-primary px-6 py-2 font-medium text-white hover:bg-primary/90 disabled:opacity-60">حفظ التوقيع</button>
        <button id="sig-cancel" type="button" class="rounded-md border px-4 py-2 font-medium hover:bg-gray-50">إلغاء</button>
      </div>
    </div>
  </dialog>

  <!-- View dialog -->
  <dialog id="sig-view-dialog" class="w-[min(30rem,calc(100vw-1.5rem))] rounded-lg bg-white p-0 text-right shadow-2xl backdrop:bg-black/50" aria-labelledby="sig-view-title">
    <div class="space-y-4 p-5 sm:p-6">
      <div class="flex items-start justify-between gap-3">
        <h2 id="sig-view-title" class="text-lg font-bold">التوقيع</h2>
        <button id="sig-view-close" type="button" class="rounded-md p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-900" aria-label="إغلاق">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
